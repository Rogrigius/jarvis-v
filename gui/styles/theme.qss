/* JARVIS Futuristic Theme - Enhanced Russian Version */

QMainWindow {
    background-color: #050a0f;
    border: 1px solid #00f2ff;
}

QWidget {
    color: #00f2ff;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    background: transparent;
}

/* Sidebar */
#Sidebar {
    background-color: rgba(10, 20, 30, 240);
    border-right: 1px solid rgba(0, 242, 255, 100);
    min-width: 90px;
}

QPushButton#SidebarButton {
    background: transparent;
    border: none;
    padding: 20px 10px;
    font-size: 14px;
    font-weight: bold;
    text-transform: uppercase;
    border-left: 4px solid transparent;
    color: rgba(0, 242, 255, 150);
}

QPushButton#SidebarButton:hover {
    background-color: rgba(0, 242, 255, 30);
    color: #00f2ff;
}

QPushButton#SidebarButton[active="true"] {
    border-left: 4px solid #00f2ff;
    background-color: rgba(0, 242, 255, 50);
    color: #00f2ff;
}

/* Content Area */
#ContentArea {
    background-color: rgba(5, 10, 15, 220);
}

QLabel#StatusLabel {
    font-size: 28px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #00f2ff;
    margin-bottom: 20px;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: rgba(10, 20, 30, 0);
    width: 6px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(0, 242, 255, 150);
    min-height: 20px;
    border-radius: 3px;
}

/* Cards & Panels */
QFrame#HUDPanel, #EditorCard {
    background-color: rgba(0, 242, 255, 15);
    border: 1px solid rgba(0, 242, 255, 60);
    border-radius: 12px;
    padding: 15px;
}

QLineEdit, QComboBox, QTextEdit {
    background-color: rgba(10, 20, 30, 180);
    border: 1px solid rgba(0, 242, 255, 80);
    border-radius: 6px;
    padding: 8px;
    color: #e0ffff;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #00f2ff;
    background-color: rgba(10, 20, 30, 220);
}

QPushButton {
    background-color: rgba(0, 242, 255, 40);
    border: 1px solid #00f2ff;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: rgba(0, 242, 255, 80);
    box-shadow: 0 0 15px rgba(0, 242, 255, 150);
}

QPushButton#ActionRemoveBtn {
    background-color: rgba(255, 50, 50, 40);
    border-color: #ff3232;
    color: #ff3232;
}
